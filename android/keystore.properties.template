# Copy this file to keystore.properties (do not commit keystore.properties or your .jks/.keystore).
# Generate a keystore:
#   keytool -genkeypair -v -storetype PKCS12 -keystore release.keystore -alias apex01 -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=apex01
keyPassword=YOUR_KEY_PASSWORD
