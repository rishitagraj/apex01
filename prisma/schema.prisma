datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  supabaseId   String?  @unique
  totalMinutes Int      @default(0)
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  todos               Todo[]
  assessments         Assessment[]
  hostedMeetings      Meeting[]             @relation("HostedMeetings")
  meetingMemberships  MeetingMember[]
  studyDays           StudyDay[]
  timetables          TimetableDay[]
  subjects            Subject[]
  conceptProgress     UserConceptProgress[]
conceptChecklists  ConceptChecklist[]
  customChecklists   ChecklistCustomItem[]
  conceptResources   ConceptResource[]
  conceptRevisions   ConceptRevision[]
  conceptDependencies ConceptDependency[]
  conceptNotes       ConceptNote[]
  conceptMistakes    ConceptMistake[]
  revisionSchedules  RevisionSchedule[]
  syllabusImports    SyllabusImport[]
  syllabusSettings   UserSyllabusSettings?
  chatMessages       ChatMessage[]
  exams              Exam[]
  resourceFolders    ResourceFolder[]
  resourceItems      ResourceItem[]
}

model UserSyllabusSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  examTags          String[] @default(["NCERT", "CBSE", "JEE Main", "NEET"])
  autoRevisionDays  Int      @default(7)
  weeklyTargetHours Int      @default(20)
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Todo {
  id        String    @id @default(cuid())
  userId    String
  title     String
  notes     String?
  priority  Priority  @default(MEDIUM)
  completed Boolean   @default(false)
  dueDate   DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Assessment {
  id        String           @id @default(cuid())
  userId    String
  subject   String
  title     String
  type      AssessmentType   @default(EXAM)
  dueDate   DateTime?
  weight    Int?
  status    AssessmentStatus @default(PLANNED)
  notes     String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AssessmentType {
  EXAM
  QUIZ
  ASSIGNMENT
  PROJECT
  OTHER
}

enum AssessmentStatus {
  PLANNED
  STUDYING
  READY
  DONE
}

model Meeting {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  hostId    String
  createdAt DateTime @default(now())

  host        User            @relation("HostedMeetings", fields: [hostId], references: [id], onDelete: Cascade)
  memberships MeetingMember[]
}

model MeetingMember {
  id              String   @id @default(cuid())
  meetingId       String
  userId          String
  joinedAt        DateTime @default(now())
  lastHeartbeatAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
}

model StudyDay {
  id      String   @id @default(cuid())
  userId  String
  date    DateTime @db.Date
  minutes Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model TimetableDay {
  id        String   @id @default(cuid())
  userId    String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots TimetableSlot[]

  @@index([userId, sortOrder])
}

model TimetableSlot {
  id        String   @id @default(cuid())
  dayId     String
  subject   String
  startAt   String
  endAt     String
  notes     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  day TimetableDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId, startAt])
}

enum SyllabusStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NEEDS_REVISION
  WEAK
  MASTERED
}

enum ChecklistTask {
  READ_THEORY
  WATCH_LECTURE
  WRITE_NOTES
  SOLVE_EXAMPLES
  NCERT_EXERCISE
  DPP
  PYQ
  REVISION_1
  REVISION_2
  REVISION_3
  REVISION_4
}

enum ResourceKind {
  PDF
  IMAGE
  MARKDOWN
  FORMULA
  DPP
  PYQ
  LINK
  YOUTUBE
  DOCUMENT
}

enum ImportStatus {
  PENDING
  PARSING
  COMPLETED
  FAILED
}

enum RevisionKind {
  REVISION_1
  REVISION_2
  REVISION_3
  REVISION_4
  MANUAL
}

model Subject {
  id         String   @id @default(cuid())
  userId     String
  name       String
  classLevel String?
  examTags   String[] @default([])
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters Chapter[]
  examLinks ExamSubject[]

  @@index([userId])
}

model Chapter {
  id             String   @id @default(cuid())
  subjectId      String
  name           String
  description    String?
  order          Int      @default(0)
  difficulty     String?
  estimatedHours Float?
  createdAt      DateTime @default(now())

  subject  Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  concepts Concept[]
  examLinks ExamChapter[]

  @@index([subjectId])
}

model Concept {
  id                 String   @id @default(cuid())
  chapterId          String
  name               String
  description        String?
  difficulty         String   @default("Medium")
  order              Int      @default(0)
  studyMinutes       Int      @default(0)
  tags               String[] @default([])
  learningObjectives String[] @default([])
  estimatedHours     Float?
  createdAt          DateTime @default(now())

  chapter           Chapter              @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  progress          UserConceptProgress?
  checklists        ConceptChecklist[]
  customChecklists  ChecklistCustomItem[]
  resources         ConceptResource[]
  revisions         ConceptRevision[]
  notes             ConceptNote?
  mistakes          ConceptMistake[]
  revisionSchedules RevisionSchedule[]
  dependencies      ConceptDependency[]  @relation("DependentConcept")
  prerequisiteOf    ConceptDependency[]  @relation("PrerequisiteConcept")

  examLinks ExamConcept[]

  @@index([chapterId])
}

model UserConceptProgress {
  id            String         @id @default(cuid())
  conceptId     String         @unique
  userId        String
  status        SyllabusStatus @default(NOT_STARTED)
  confidence    Int            @default(0)
  coverage      Int            @default(0)
  studyMinutes  Int            @default(0)
  needsRevision Boolean        @default(false)
  lastStudiedAt DateTime?
  lastRevisedAt DateTime?
  updatedAt     DateTime       @updatedAt

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conceptId, userId])
  @@index([userId, status])
}

model ConceptChecklist {
  id        String        @id @default(cuid())
  conceptId String
  userId    String
  task      ChecklistTask
  label     String?
  done      Boolean       @default(false)
  hidden    Boolean       @default(false)
  order     Int           @default(0)

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([conceptId, userId, task])
  @@index([userId])
}

model ChecklistCustomItem {
  id        String   @id @default(cuid())
  conceptId String
  userId    String
  label     String
  done      Boolean  @default(false)
  order     Int      @default(0)
  weight    Int      @default(5)
  createdAt DateTime @default(now())

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([conceptId])
}

model ConceptResource {
  id        String       @id @default(cuid())
  conceptId String
  userId    String
  kind      ResourceKind
  title     String
  url       String?
  key       String?
  size      Int          @default(0)
  favourite Boolean      @default(false)
  createdAt DateTime     @default(now())

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([userId, favourite])
}

model ConceptRevision {
  id        String       @id @default(cuid())
  conceptId String
  userId    String
  kind      RevisionKind @default(MANUAL)
  note      String?
  revisedAt DateTime     @default(now())

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([userId, revisedAt])
}

model ConceptDependency {
  id             String @id @default(cuid())
  conceptId      String
  prerequisiteId String
  userId         String

  concept      Concept @relation("DependentConcept", fields: [conceptId], references: [id], onDelete: Cascade)
  prerequisite Concept @relation("PrerequisiteConcept", fields: [prerequisiteId], references: [id], onDelete: Cascade)
  user         User    @relation(fields: [userId], references: [id])

  @@unique([conceptId, prerequisiteId])
  @@index([userId])
}

model ConceptNote {
  id        String   @id @default(cuid())
  conceptId String   @unique
  userId    String
  body      String   @default("")
  updatedAt DateTime @updatedAt

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([conceptId, userId])
}

model ConceptMistake {
  id        String   @id @default(cuid())
  conceptId String
  userId    String
  text      String
  source    String?
  createdAt DateTime @default(now())

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model RevisionSchedule {
  id        String       @id @default(cuid())
  conceptId String
  userId    String
  date      DateTime     @db.Date
  kind      RevisionKind
  done      Boolean      @default(false)

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([conceptId, userId, date])
  @@index([userId, date])
}

model SyllabusImport {
  id            String       @id @default(cuid())
  userId        String
  course        String
  pdfName       String?
  fileKey       String?
  status        ImportStatus @default(PENDING)
  instructions  String?
  warnings      Json?
  summary       Json?
  createdAt     DateTime     @default(now())
  completedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ChatChannel {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  messages ChatMessage[]

  @@index([sortOrder])
}

model ChatMessage {
  id         String   @id @default(cuid())
  channelId  String
  userId     String
  authorName String
  content    String
  imageKey   String?
  imageType  String?
  createdAt  DateTime @default(now())

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

enum ExamType {
  UNIT_TEST
  MIDTERM
  ANNUAL
  QUIZ
  CUSTOM
}

// Exam tracking. Exams reference existing syllabus rows by id (never duplicate
// chapter/concept content); progress is always derived live from the concept
// progress that powers Syllabus Coverage.
model Exam {
  id         String   @id @default(cuid())
  userId     String
  name       String
  date       DateTime @db.Date
  time       String?
  type       ExamType @default(UNIT_TEST)
  classLevel String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects ExamSubject[]
  chapters ExamChapter[]
  concepts ExamConcept[]
  attempts ExamAttempt[]

  @@index([userId, date])
}

model ExamSubject {
  id        String @id @default(cuid())
  examId    String
  subjectId String

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([examId, subjectId])
  @@index([subjectId])
}

model ExamChapter {
  id        String @id @default(cuid())
  examId    String
  chapterId String

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([examId, chapterId])
  @@index([chapterId])
}

// Individually selected concepts (when the user picks concepts inside a chapter
// rather than the whole chapter).
model ExamConcept {
  id        String @id @default(cuid())
  examId    String
  conceptId String

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([examId, conceptId])
  @@index([conceptId])
}

model ExamAttempt {
  id           String   @id @default(cuid())
  examId       String
  attemptDate  DateTime @db.Date
  marks        Int?
  maxMarks     Int?
  subjectMarks Json?
  weakTopics   String?
  mistakes     String?
  reflections  String?
  createdAt    DateTime @default(now())

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId, attemptDate])
}

// Personal resource library: folders group saved links (PDFs, images, videos…).
model ResourceFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ResourceItem[]

  @@index([userId, sortOrder])
}

model ResourceItem {
  id        String       @id @default(cuid())
  userId    String
  folderId  String?
  kind      ResourceKind @default(LINK)
  title     String
  url       String
  notes     String?
  fileKey   String?      @unique
  fileName  String?
  fileSize  Int?
  mimeType  String?
  createdAt DateTime     @default(now())

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder ResourceFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId, folderId])
  @@index([userId, createdAt])
}
