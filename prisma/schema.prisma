datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  supabaseId   String?  @unique
  totalMinutes Int      @default(0)
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  todos              Todo[]
  assessments        Assessment[]
  hostedMeetings     Meeting[]       @relation("HostedMeetings")
  meetingMemberships MeetingMember[]
  studyDays          StudyDay[]
  timetables         TimetableDay[]
}

model Todo {
  id        String    @id @default(cuid())
  userId    String
  title     String
  notes     String?
  priority  Priority  @default(MEDIUM)
  completed Boolean   @default(false)
  dueDate   DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Assessment {
  id        String           @id @default(cuid())
  userId    String
  subject   String
  title     String
  type      AssessmentType   @default(EXAM)
  dueDate   DateTime?
  weight    Int?
  status    AssessmentStatus @default(PLANNED)
  notes     String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AssessmentType {
  EXAM
  QUIZ
  ASSIGNMENT
  PROJECT
  OTHER
}

enum AssessmentStatus {
  PLANNED
  STUDYING
  READY
  DONE
}

model Meeting {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  hostId    String
  createdAt DateTime @default(now())

  host        User             @relation("HostedMeetings", fields: [hostId], references: [id], onDelete: Cascade)
  memberships MeetingMember[]
}

model MeetingMember {
  id              String   @id @default(cuid())
  meetingId       String
  userId          String
  minutes         Int      @default(0)
  joinedAt        DateTime @default(now())
  lastHeartbeatAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
}

model StudyDay {
  id      String   @id @default(cuid())
  userId  String
  date    DateTime @db.Date
  minutes Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model TimetableDay {
  id        String          @id @default(cuid())
  userId    String
  name      String
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots TimetableSlot[]

  @@index([userId, sortOrder])
}

model TimetableSlot {
  id        String   @id @default(cuid())
  dayId     String
  subject   String
  startAt   String
  endAt     String
  notes     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  day TimetableDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId, startAt])
}