# PostgreSQL connection string (e.g. Neon, Vercel Postgres, Supabase)
# Get one free at https://neon.tech
DATABASE_URL="postgresql://user:password@host:5432/database"

# Supabase project credentials — from Project Settings → API
# NEXT_PUBLIC_* are used by the browser; SUPABASE_SERVICE_ROLE_KEY is server-only
# and MUST NOT be exposed to the client (used to create the admin account).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ...your-anon-key..."
SUPABASE_SERVICE_ROLE_KEY="eyJ...your-service-role-key..."

# MiroTalk P2P server used for study rooms (self-hosted / Render.com instance, no domain prefix)
# e.g. "p2p-latest-ajnb.onrender.com" or "p2p.mirotalk.com"
NEXT_PUBLIC_MIROTALK_DOMAIN="p2p-latest-ajnb.onrender.com"

# Public URL of the deployed app (used to build redirect URLs for auth emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"