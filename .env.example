# PostgreSQL connection string (e.g. Neon, Vercel Postgres, Supabase)
# Get one free at https://neon.tech
DATABASE_URL="postgresql://user:password@host:5432/database"

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Jitsi Meet server used for study rooms (self-host or use the public one)
NEXT_PUBLIC_JITSI_DOMAIN="meet.jit.si"

# Public URL of the deployed app (optional, used for branding links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"