# PostgreSQL connection string (e.g. Neon, Vercel Postgres, Supabase)
# Get one free at https://neon.tech
DATABASE_URL="postgresql://user:password@host:5432/database"

# Supabase project credentials — from Project Settings → API
# NEXT_PUBLIC_* are used by the browser; SUPABASE_SERVICE_ROLE_KEY is server-only
# and MUST NOT be exposed to the client (used to create the admin account).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ...your-anon-key..."
SUPABASE_SERVICE_ROLE_KEY="eyJ...your-service-role-key..."

# MiroTalk P2P server used for study rooms (self-hosted / Render.com instance, no domain prefix)
# e.g. "p2p-latest-ajnb.onrender.com" or "p2p.mirotalk.com"
NEXT_PUBLIC_MIROTALK_DOMAIN="p2p-latest-ajnb.onrender.com"

# Public URL of the deployed app (used to build redirect URLs for auth emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Cloud Vision API key — used for handwriting-to-text (reads cursive/full sentences).
# Server-only, never exposed to the browser. Create one in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials  →  Create credentials → API key,
# then enable the "Cloud Vision API" (https://console.cloud.google.com/apis/library/vision.googleapis.com).
# Leave empty to fall back to the smaller offline handwriting model instead.
GOOGLE_VISION_API_KEY=""

# ---- Syllabus OS (AI importer + knowledge graph) ----
# Groq API key - turns a syllabus PDF into a structured roadmap (server-only).
# Get one free at https://console.groq.com/keys
GROQ_API_KEY=""

# Cloudflare R2 (S3-compatible) - temporary storage for uploaded syllabus PDFs.
# Create a bucket in the dashboard, then grab the S3 API credentials from
# Account > R2 > Manage R2 API Tokens.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="apex-storage"