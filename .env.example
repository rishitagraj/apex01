# PostgreSQL connection string (e.g. Neon, Vercel Postgres, Supabase)
# Get one free at https://neon.tech
DATABASE_URL="postgresql://user:password@host:5432/database"

# Supabase project credentials — from Project Settings → API
# NEXT_PUBLIC_* are used by the browser; SUPABASE_SERVICE_ROLE_KEY is server-only
# and MUST NOT be exposed to the client (used to create the admin account).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ...your-anon-key..."
SUPABASE_SERVICE_ROLE_KEY="eyJ...your-service-role-key..."

# MiroTalk P2P server used for study rooms (self-hosted / Render.com instance, no domain prefix)
# e.g. "p2p-latest-ajnb.onrender.com" or "p2p.mirotalk.com"
NEXT_PUBLIC_MIROTALK_DOMAIN="p2p-latest-ajnb.onrender.com"

# Public URL of the deployed app (used to build redirect URLs for auth emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Cloud Vision API key — used for handwriting-to-text (reads cursive/full sentences).
# Server-only, never exposed to the browser. Create one in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials  →  Create credentials → API key,
# then enable the "Cloud Vision API" (https://console.cloud.google.com/apis/library/vision.googleapis.com).
# Leave empty to fall back to the smaller offline handwriting model instead.
GOOGLE_VISION_API_KEY=""

# ---- Syllabus OS (AI importer + knowledge graph) ----
# Groq API key - turns a syllabus PDF into a structured roadmap (server-only).
# Get one free at https://console.groq.com/keys
GROQ_API_KEY=""

# Gemini Flash - alternative AI engine with a ~1M-token context (reads the whole
# syllabus, no truncation). Get a free key at https://aistudio.google.com/apikey.
# Leave GEMINI_API_KEY empty to keep Groq as the only working engine; users can
# still switch to Gemini Flash in the import wizard (they'll get a helpful error).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Backblaze B2 (S3-compatible) - temporary storage for uploaded syllabus PDFs.
# Create a bucket, then create an Application Key with "Read & Write" access
# (Bucket settings > Application Keys). B2_REGION is your bucket's S3 region,
# e.g. us-west-004. The bucket must allow CORS PUT to the syllabus-pdfs/ prefix.
B2_APPLICATION_KEY_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET="apex-storage"
# Dedicated bucket for document uploads in the Resources tab when using B2.
# Defaults to "dbbytes".
B2_RESOURCES_BUCKET="dbbytes"
B2_REGION="us-west-004"

# Personal document storage can use DBByte's S3-compatible API instead of B2.
# Set RESOURCE_STORAGE="dbbyte" and fill in the DBByte key + bucket. When
# DBBYTE_ACCESS_KEY_ID is present and RESOURCE_STORAGE is unset, DBByte is used.
# DBByte allows browser GET/HEAD only, so uploads are relayed through the app in
# 4 MiB parts. It also rejects PowerPoint, Excel, RTF, OpenDocument and EPUB
# files; use B2 if those types must be uploadable.
RESOURCE_STORAGE="b2"
DBBYTE_ENDPOINT="https://s3.dbbyte.com"
DBBYTE_REGION="auto"
DBBYTE_BUCKET="my-first-bucket"
DBBYTE_ACCESS_KEY_ID=""
DBBYTE_SECRET_ACCESS_KEY=""